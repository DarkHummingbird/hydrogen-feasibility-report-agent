# 复制成 backend/.env 后填真实值；.env 已在 .gitignore 中，不会进仓库
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=3
MAX_UPLOAD_MB=100
TARGET_WORDS_DEFAULT=12000
TARGET_WORDS_MAX=18000
PORT=8010
# 阶段 2-2
RETRIEVE_CHAPTER_SEGMENTS=6
RETRIEVE_FACT_SEGMENTS=3
REWRITE_MAX=2
CHAPTER_WORDS_RATIO=1.1
